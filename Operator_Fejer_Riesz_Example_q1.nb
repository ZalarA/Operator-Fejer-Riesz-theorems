Cell["\<\
The four boundary values force \[Sigma]1(j) = 1/w(j). Interpolate those \
values with degree at most three to obtain the polynomial used in the \
minimality argument; its quadratic coefficient is negative.\
\>", "Text",ExpressionUUID->"0749ed1b-1b72-ea4b-83cb-3a777f1c1905"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Interpolation", " ", "of", " ", 
     RowBox[{"1", "/", "w"}], " ", "at", " ", "the", " ", "endpoints", " ", 
     "0"}], ",", "1", ",", "2", ",", "3"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"endpointValues", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"w", "/.", " ", 
            RowBox[{"x", "->", "j"}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pInterp", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{"InterpolatingPolynomial", "[", 
       RowBox[{"endpointValues", ",", "x"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"TableForm", "[", 
    RowBox[{"endpointValues", ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "\"\<1/w(x)\>\""}], "}"}]}], "}"}]}]}], 
    "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "the", " ", "interpolating", " ", "polynomial"}], 
    "*)"}], "\n", "pInterp"}]}]], "Input",
 CellChangeTimes->{
  4.0023644528024254`*^9, {4.002364528489113*^9, 4.00236453100041*^9}},
 CellLabel->
  "In[242]:=",ExpressionUUID->"23ee8a76-9141-a14c-aa9d-7d4a41b9c958"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["\<\"x\"\>",
       HoldForm], 
      TagBox["\<\"1/w(x)\"\>",
       HoldForm]},
     {"0", 
      FractionBox["1", "6"]},
     {"1", 
      FractionBox["1", "2"]},
     {"2", 
      FractionBox["1", "2"]},
     {"3", 
      FractionBox["1", "6"]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
