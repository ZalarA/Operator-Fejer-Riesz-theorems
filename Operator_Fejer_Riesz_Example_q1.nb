Cell[CellGroupData[{

Cell["Claim 3: scalar certificate for \[CapitalDelta] in M(S0)", "Section",ExpressionUUID->"a595d194-fd7b-3645-8c49-4afc3e8e8df0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Claim", " ", "3"}], ":", 
    RowBox[{
    "Scalar", " ", "certificate", " ", "for", " ", "Delta", " ", "in", " ", 
     "M", 
     RowBox[{"(", "S0", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Natural", " ", "generators", " ", "of", " ", "S0"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"s0", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "x", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "2"}], ")"}]}], ",", 
       RowBox[{"3", "-", "x"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Three", " ", "nonzero", " ", "summands", " ", "in", " ", "the", " ", 
     "certificate", " ", "for", " ", "Delta"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaTerms", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "1"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"x", "-", "2"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"x", "-", "3"}], ")"}]}], ")"}], "^", "2"}], "/", 
         "6"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "2"}], ")"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", " ", 
            RowBox[{"(", 
             RowBox[{"x", "-", "3"}], ")"}]}], ")"}], "^", "2"}], "/", 
         "2"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", "-", "x"}], ")"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", " ", 
            RowBox[{"(", 
             RowBox[{"x", "-", "1"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"x", "-", "2"}], ")"}]}], ")"}], "^", "2"}], "/", 
         "6"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "their", " ", "sum"}], "*)"}], "\n", 
   RowBox[{"Factor", "[", 
    RowBox[{"Total", "[", "deltaTerms", "]"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "the", " ", "weighted", " ", "degrees"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Exponent", "[", 
      RowBox[{"#", ",", "x"}], "]"}], "&"}], "/@", "deltaTerms"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Minimum", " ", "degrees", " ", "forced", " ", "by", " ", "double", " ", 
     "zeros", " ", "at", " ", "endpoints"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"endpoints", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"positiveEndpoints", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"endpoints", ",", 
         RowBox[{"Function", "[", 
          RowBox[{"z", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"s0", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "/.", " ", 
              RowBox[{"x", "->", "z"}]}], ")"}], ">", "0"}]}], "]"}]}], "]"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", "s0", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minSOSDegrees", "=", 
     RowBox[{"2", " ", 
      RowBox[{"Length", "/@", "positiveEndpoints"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minWeightedDegrees", "=", 
     RowBox[{"minSOSDegrees", "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "x"}], "]"}], "&"}], "/@", "s0"}], ")"}]}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"TableForm", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"j", "-", "1"}], ",", 
         RowBox[{"s0", "[", 
          RowBox[{"[", "j", "]"}], "]"}], ",", 
         RowBox[{"positiveEndpoints", "[", 
          RowBox[{"[", "j", "]"}], "]"}], ",", 
         RowBox[{"minSOSDegrees", "[", 
          RowBox[{"[", "j", "]"}], "]"}], ",", 
         RowBox[{"minWeightedDegrees", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", "s0", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Index\>\"", ",", "\"\<Generator\>\"", 
          ",", "\"\<Positive at\>\"", ",", "\"\<Min SOS degree\>\"", 
          ",", "\"\<Min weighted degree\>\""}], "}"}]}], "}"}]}]}], "]"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "At", " ", "weighted", " ", "degree", " ", "at", " ", "most", " ", "6"}],
      ",", 
     RowBox[{
     "only", " ", "the", " ", "third", " ", "generator", " ", "can", " ", 
      "have", " ", "a", " ", "nonzero", " ", "SOS", " ", 
      RowBox[{"multiplier", ".", "Its"}], " ", "multiplier", " ", "must", " ",
       "be", " ", "c", " ", 
      RowBox[{"x", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", "3"}], ")"}], "^", "2."}]}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"remainingTerm", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"s0", "[", 
        RowBox[{"[", "3", "]"}], "]"}], " ", 
       RowBox[{"x", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "3"}], ")"}], "^", "2"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]",
    "remainingTerm", "\n", "\[IndentingNewLine]", 
   RowBox[{"Exponent", "[", 
    RowBox[{"remainingTerm", ",", "x"}], "]"}]}]}]], "Input",
