Cell[CellGroupData[{
Cell["Operator Fej\[EAcute]r\[Dash]Riesz with gaps: explicit degree bounds", \
"Title",ExpressionUUID->"db98ad3d-a6ef-1e47-9487-8648ce395124"],

Cell["Exact Mathematica computations for Appendix B (choice q = 1)", \
"Subtitle",ExpressionUUID->"64db18f4-aee2-ee45-9be0-ce72c62f7fea"],

Cell[CellGroupData[{

Cell["Basic interval data and rank-one pencil", "Section",ExpressionUUID->"dfe4423b-91f5-0143-a084-486a3fd08d27"],

Cell["Form P, Q, R = Q \[Minus] P, and \[CapitalDelta] = \[Minus]PQ from the \
endpoints.", "Text",ExpressionUUID->"48d553ce-1788-a649-a293-b15f63adf9da"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Interval", " ", "endpoints"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ell", "=", 
    RowBox[{"Length", "[", "a", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Endpoint", " ", "polynomials"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{"x", "-", 
       RowBox[{"a", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "ell"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"q", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"Product", "[", 
     RowBox[{
      RowBox[{"x", "-", 
       RowBox[{"b", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "ell"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"q", "-", "p"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"delta", "=", 
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"-", "p"}], "*", "q"}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Display", " ", "the", " ", "polynomials"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<P\>\"", ",", "p"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Q\>\"", ",", "q"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<R\>\"", ",", "r"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Delta\>\"", ",", "delta"}], "}"}]}], "}"}], ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Polynomial\>\"", ",", "\"\<Expression\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{4.002363874351843*^9},
 CellLabel->
  "In[209]:=",ExpressionUUID->"e68d90fe-6dac-aa44-b871-19bd3c72df41"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["\<\"Polynomial\"\>",
       HoldForm], 
      TagBox["\<\"Expression\"\>",
       HoldForm]},
     {"\<\"P\"\>", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "x"}], "+", 
       SuperscriptBox["x", "2"]}]},
     {"\<\"Q\"\>", 
      RowBox[{"3", "-", 
       RowBox[{"4", " ", "x"}], "+", 
       SuperscriptBox["x", "2"]}]},
     {"\<\"R\"\>", 
      RowBox[{"3", "-", 
       RowBox[{"2", " ", "x"}]}]},
     {"\<\"Delta\"\>", 
      RowBox[{
       RowBox[{"6", " ", "x"}], "-", 
       RowBox[{"11", " ", 
        SuperscriptBox["x", "2"]}], "+", 
       RowBox[{"6", " ", 
        SuperscriptBox["x", "3"]}], "-", 
       SuperscriptBox["x", "4"]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
