Cell[CellGroupData[{

Cell["Claim 2: scalar SOS identity and minimal degree", "Section",ExpressionUUID->"f9d30c72-1f0d-0f41-935a-10e715089445"],

Cell["\<\
Compute the multipliers \[Sigma]1 and \[Tau] in the displayed SOS form, then \
expand the scalar identity 1 = w \[Sigma]1 + \[CapitalDelta] \[Tau]. The \
choice \[Sigma]0 = \[CapitalDelta]\.b2 \[Tau] gives \[CapitalDelta] = \
\[Sigma]0 + w \[CapitalDelta] \[Sigma]1.\
\>", "Text",ExpressionUUID->"a8731223-a8bb-1943-b872-3ea31013bfbc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigma1", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "4"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", " ", "-", " ", 
            RowBox[{"3", "/", "2"}]}], ")"}], "^", "2"}], " ", "-", " ", 
         RowBox[{"19", "/", "12"}]}], ")"}], "^", "2"}]}], " ", "+", " ", 
     RowBox[{"1", "/", "18"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tau", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", " ", "-", " ", 
         RowBox[{"3", "/", "2"}]}], ")"}], "^", "2"}]}], " ", "+", " ", 
     RowBox[{"1", "/", "24"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigma0", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"delta", "^", "2"}], " ", "tau"}], "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<sigma1\>\"", ",", " ", "sigma1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<tau\>\"", ",", " ", "tau"}], "}"}]}], "}"}], 
  "]"}]}], "Input",
 CellLabel->
  "In[235]:=",ExpressionUUID->"83514cdd-0b64-2f40-a412-3a2791d1242b"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"sigma1\"\>", 
     RowBox[{
      FractionBox["1", "6"], "-", "x", "+", 
      FractionBox[
       RowBox[{"31", " ", 
        SuperscriptBox["x", "2"]}], "12"], "-", 
      FractionBox[
       RowBox[{"3", " ", 
        SuperscriptBox["x", "3"]}], "2"], "+", 
      FractionBox[
       SuperscriptBox["x", "4"], "4"]}]},
    {"\<\"tau\"\>", 
     RowBox[{
      FractionBox["7", "6"], "-", 
      FractionBox[
       RowBox[{"3", " ", "x"}], "2"], "+", 
      FractionBox[
       SuperscriptBox["x", "2"], "2"]}]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[2.0999999999999996`]}, 
       Offset[0.27999999999999997`]}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}}],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$]]]], "Output",
