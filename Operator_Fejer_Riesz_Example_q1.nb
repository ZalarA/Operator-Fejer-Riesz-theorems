Cell["\<\
Construct the rank-one pencil T(y) = D \[Minus] y vv\:1d40 and its polynomial \
eigenvector u(x); w(x) = u(x)\:1d40u(x) is the new strictly positive \
multiplier.\
\>", "Text",ExpressionUUID->"84c6f0ab-2ea3-a143-bc9d-9090ab5d06b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Construct", " ", "the", " ", "rank"}], "-", 
    RowBox[{"one", " ", "symmetric", " ", "pencil"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"v", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p", "/.", " ", 
           RowBox[{"x", "->", 
            RowBox[{"b", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"q", ",", "x"}], "]"}], "/.", " ", 
           RowBox[{"x", "->", 
            RowBox[{"b", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "ell"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dmat", "=", 
     RowBox[{"DiagonalMatrix", "[", "b", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"tmat", "[", "y_", "]"}], ":=", 
     RowBox[{"dmat", "-", 
      RowBox[{"y", " ", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "v", ",", "v"}], "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Construct", " ", "the", " ", "polynomial", " ", "eigenvector", " ", "u", 
     RowBox[{"(", "x", ")"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", "j", "]"}], "]"}], " ", 
        RowBox[{"PolynomialQuotient", "[", 
         RowBox[{"q", ",", 
          RowBox[{"x", "-", 
           RowBox[{"b", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ",", "x"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "ell"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Strictly", " ", "positive", " ", "polynomial", " ", "w", 
     RowBox[{"(", "x", ")"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"w", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{"u", ".", "u"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "the", " ", "results"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{"tmat", "[", "y", "]"}], "]"}], "]"}], "\n", 
   RowBox[{"MatrixForm", "[", "u", "]"}], "\n", 
   RowBox[{"Factor", "[", "w", "]"}]}]}]], "Input",
 CellChangeTimes->{4.0023639382731113`*^9, 4.002364012397608*^9},
 CellLabel->
  "In[218]:=",ExpressionUUID->"721077cb-5c77-c040-a1bd-aa4646a054de"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{"1", "-", 
       FractionBox["y", "2"]}], 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SqrtBox["3"], " ", "y"}], "2"]}]},
     {
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SqrtBox["3"], " ", "y"}], "2"]}], 
      RowBox[{"3", "-", 
