Cell[CellGroupData[{

Cell["Claim 5: obstruction to weighted degree eight", "Section",ExpressionUUID->"bcffebd3-2fd8-5946-9edd-aa0412966658"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Claim", " ", "5"}], ":", 
    RowBox[{
    "Obstruction", " ", "to", " ", "weighted", " ", "degree", " ", "8"}]}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Natural", " ", "generators", " ", "of", " ", "S1"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"s1", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "x", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "2"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "3"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "4"}], ")"}]}], ",", 
       RowBox[{"4", "-", "x"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"endpoints1", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Endpoints", " ", "where", " ", "each", " ", "generator", " ", "is", " ", 
     "strictly", " ", "positive"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"positiveEndpoints", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{"endpoints1", ",", 
         RowBox[{"Function", "[", 
          RowBox[{"z", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"s1", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "/.", " ", 
              RowBox[{"x", "->", "z"}]}], ")"}], ">", "0"}]}], "]"}]}], "]"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", "s1", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Minimum", " ", "SOS", " ", "degrees", " ", "forced", " ", "by", " ", 
     "double", " ", "zeros"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minSigma1", "=", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"Length", "/@", "positiveEndpoints"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Maximum", " ", "SOS", " ", "degrees", " ", "allowed", " ", "by", " ", 
     "weighted", " ", "degree", " ", "8"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxSigmaAt8", "=", 
     RowBox[{"8", "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "x"}], "]"}], "&"}], "/@", "s1"}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "the", " ", "degree", " ", "restrictions"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"TableForm", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
       "s1", ",", "positiveEndpoints", ",", "minSigma1", ",", "maxSigmaAt8"}],
        "}"}], "]"}], ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Generator\>\"", ",", "\"\<Positive endpoints\>\"", 
          ",", "\"\<Min SOS degree\>\"", ",", "\"\<Max SOS degree at 8\>\""}],
          "}"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generators", " ", "that", " ", "can", " ", "have", " ", "nonzero", " ", 
     "SOS", " ", "multipliers"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"survivingGenerators", "=", 
     RowBox[{"Pick", "[", 
      RowBox[{"s1", ",", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", "<=", "#2"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"minSigma1", ",", "maxSigmaAt8"}], "}"}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", "survivingGenerators", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Polynomial", " ", "obstruction", " ", "from", " ", "the", " ", "proof"}],
     "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"c1", ",", "aa", ",", "bb", ",", "psi", ",", "obstruction"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "General", " ", "affine", " ", "polynomial", " ", "satisfying", " ", 
      "psi", 
      RowBox[{"(", "4", ")"}]}], "=", "1"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"psi", "=", 
     RowBox[{"1", "+", 
      RowBox[{"c1", " ", 
       RowBox[{"(", 
        RowBox[{"x", "-", "4"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Polynomial", " ", "identity", " ", "that", " ", "would", " ", "have", " ",
      "to", " ", "hold"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"obstruction", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"psi", "^", "2"}]}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "4"}], ")"}]}], "-", 
       RowBox[{"aa", " ", "x", " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "3"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "4"}], ")"}]}], "-", 
       RowBox[{"bb", " ", "x", " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "2"}], ")"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Display", " ", "the", " ", "constant", " ", "and", " ", "cubic", " ", 
     "coefficients"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"TableForm", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Constant coefficient\>\"", ",", 
         RowBox[{"Factor", "[", 
          RowBox[{"Coefficient", "[", 
           RowBox[{"obstruction", ",", "x", ",", "0"}], "]"}], "]"}]}], "}"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Cubic coefficient\>\"", ",", 
         RowBox[{"Factor", "[", 
          RowBox[{"Coefficient", "[", 
           RowBox[{"obstruction", ",", "x", ",", "3"}], "]"}], "]"}]}], 
        "}"}]}], "}"}], ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Coefficient\>\"", ",", "\"\<Expression\>\""}], "}"}]}], 
       "}"}]}]}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "The", " ", "constant", " ", "coefficient", " ", "forces", " ", "c1"}], "=", 
     RowBox[{"1", "/", "4"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c1Solutions", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"obstruction", ",", "x", ",", "0"}], "]"}], "==", "0"}], ",",
        "c1"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", "c1Solutions", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Substitute", " ", "into", " ", "the", " ", "cubic", " ", "coefficient"}],
     "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Factor", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{"obstruction", ",", "x", ",", "3"}], "]"}], "/.", " ", 
     RowBox[{"First", "[", "c1Solutions", "]"}]}], "]"}]}]}]], "Input",
