Cell[CellGroupData[{

Cell["Claim 4: explicit matrix certificate for the isolated point", "Section",ExpressionUUID->"55b3973d-7701-9441-8219-8055b42f87ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Claim", " ", "4"}], ":", 
     RowBox[{
     "Matrix", " ", "certificate", " ", "for", " ", "the", " ", "isolated", " ",
       "point", " ", "xi"}]}], "=", "4"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Compute", " ", "deltaXi"}], "=", 
    RowBox[{
     RowBox[{"-", "Delta"}], 
     RowBox[{"(", "4", ")"}], " ", "and", " ", "construct", " ", "G4"}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"xi", "=", "4"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaXi", "=", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"delta", "/.", " ", 
        RowBox[{"x", "->", "xi"}]}], ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g4", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"deltaXi", "+", "delta"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "xi"}], ")"}], " ", "delta"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "xi"}], ")"}], " ", "delta"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "xi"}], ")"}], "^", "2"}], " ", "delta"}]}], 
        "}"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", "deltaXi", "\n",
    "\[IndentingNewLine]", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"Expand", ",", "g4", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "the", " ", "determinant", " ", "of", " ", "G4"}],
     "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Factor", "[", 
    RowBox[{"Det", "[", "g4", "]"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Construct", " ", "the", " ", "four", " ", "terms", " ", "in", " ", "the",
      " ", "matrix", " ", "certificate"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "2"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "3"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "4"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p2", "=", 
     RowBox[{"x", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "3"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "4"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p3", "=", 
     RowBox[{"x", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "2"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p4", "=", 
     RowBox[{"x", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "2"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "3"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Scalar", " ", "SOS", " ", "multipliers"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tauPt", "=", 
     RowBox[{
      RowBox[{"x", "^", "2"}], "-", 
      RowBox[{"3", " ", "x"}], "+", 
      RowBox[{"27", "/", "8"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rho1", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "-", "x"}], ")"}], "^", "2"}], " ", 
      RowBox[{"tauPt", "/", "4"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rho4", "=", 
     RowBox[{
      RowBox[{"x", "^", "2"}], "+", 
      RowBox[{"3", "/", "2"}], "+", 
      RowBox[{
       RowBox[{"x", "^", "2"}], " ", 
       RowBox[{"tauPt", "/", "4"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Polynomial", " ", "vectors", " ", "for", " ", "the", " ", "rank"}], "-", 
     RowBox[{"one", " ", "matrix", " ", "terms"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"u3", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "4"}], ",", 
       RowBox[{"p3", "/", "6"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"u4", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"3", "/", "4"}], ",", 
       RowBox[{"p4", "/", "6"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Four", " ", "weighted", " ", "matrix", " ", "terms"}], "*)"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"matrixTerms", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"rho1", ",", 
           RowBox[{
            RowBox[{"p1", "^", "2"}], "/", "6"}]}], "}"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "2"}], ")"}], " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"p2", "^", "2"}], "/", "2"}]}], "}"}], "]"}]}], ",", 
       RowBox[{"6", " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "3"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "4"}], ")"}], " ", 
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", "u3", ",", "u3"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"4", "-", "x"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"6", " ", 
           RowBox[{"Outer", "[", 
            RowBox[{"Times", ",", "u4", ",", "u4"}], "]"}]}], "+", 
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"{", 
            RowBox[{"rho4", ",", "0"}], "}"}], "]"}]}], ")"}]}]}], "}"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "and", " ", "display", " ", "the", " ", "expanded", " ", 
     "certificate"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"matrixSum", "=", 
     RowBox[{"Map", "[", 
      RowBox[{"Expand", ",", 
       RowBox[{"Total", "[", "matrixTerms", "]"}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"MatrixForm", "[", "matrixSum", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "G4", " ", "for", " ", "comparison"}], "*)"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"Expand", ",", "g4", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "the", " ", "weighted", " ", "degrees", " ", "of", " ", 
     "the", " ", "four", " ", "terms"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"weightedDegrees", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{"#", ",", "x"}], "]"}], "&"}], "/@", 
         RowBox[{"Flatten", "[", 
          RowBox[{"matrixTerms", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", "matrixTerms", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", "weightedDegrees", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Express", " ", "tauPt", " ", "as", " ", "a", " ", "completed", " ", 
     "square"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "s", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Expand", "[", 
    RowBox[{"tauPt", "/.", " ", 
     RowBox[{"x", "->", 
      RowBox[{"s", "+", 
       RowBox[{"3", "/", "2"}]}]}]}], "]"}]}]}]], "Input",
