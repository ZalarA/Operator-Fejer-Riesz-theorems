Cell["\<\
For q = 1, C(y) = R(T(y))\:207b\.b9 is affine. The calculation also gives the \
compressed polynomial eigenvector identity R(x) C(t(x))u(x) = u(x).\
\>", "Text",ExpressionUUID->"339fbad8-859f-e04a-b9f8-c9a84aecc4e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Construct", " ", "R", 
    RowBox[{"(", 
     RowBox[{"T", 
      RowBox[{"(", "y", ")"}]}], ")"}], " ", "and", " ", "its", " ", 
    "inverse", " ", "C", 
    RowBox[{"(", "y", ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"rmat", "[", "y_", "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"r", ",", "x", ",", "k"}], "]"}], " ", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{
          RowBox[{"tmat", "[", "y", "]"}], ",", "k"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"ell", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cmat", "[", "y_", "]"}], ":=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Inverse", "[", 
       RowBox[{"rmat", "[", "y", "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "C", 
     RowBox[{"(", "y", ")"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"cmat", "[", "y", "]"}], "]"}], "]"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "T", 
     RowBox[{"(", "y", ")"}], " ", "C", 
     RowBox[{"(", "y", ")"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"tmat", "[", "y", "]"}], ".", 
      RowBox[{"cmat", "[", "y", "]"}]}], "]"}], "]"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Compute", " ", "R", 
      RowBox[{"(", "x", ")"}], " ", "C", 
      RowBox[{"(", 
       RowBox[{"t", 
        RowBox[{"(", "x", ")"}]}], ")"}], " ", "u", 
      RowBox[{"(", "x", ")"}]}], ",", 
     RowBox[{
      RowBox[{"where", " ", "t", 
       RowBox[{"(", "x", ")"}]}], "=", 
      RowBox[{"Q", 
       RowBox[{
        RowBox[{"(", "x", ")"}], "/", "R"}], 
       RowBox[{"(", "x", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t", "=", 
     RowBox[{"q", "/", "r"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"recoveredU", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Cancel", "/@", 
       RowBox[{"(", 
        RowBox[{"r", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"cmat", "[", "t", "]"}], ".", "u"}], ")"}]}], ")"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"MatrixForm", "[", "recoveredU", "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0023640517969456`*^9, 4.0023640517969456`*^9}, 
   4.0023644343520584`*^9},
 CellLabel->
  "In[228]:=",ExpressionUUID->"37981401-a835-2648-b014-4e0858058270"],

